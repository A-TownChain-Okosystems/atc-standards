{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ATC Naming Conventions (ATC-STD-000 s36)",
  "description": "Maschinenpruefbare Benennungsnorm des ATC-Standardsystems. CI lehnt ungueltige Namen ab (atc-std-validator Regel S-16).",
  "type": "object",
  "required": ["ids", "repositories", "files", "immutability"],
  "properties": {
    "ids": {
      "type": "object",
      "description": "Objekt-IDs; NNN = mindestens dreistellig, fuehrende Nullen erlaubt",
      "properties": {
        "standard":              {"pattern": "^ATC-STD-[0-9]{3,}$", "example": "ATC-STD-000"},
        "requirement":           {"pattern": "^REQ-[A-Z]+(-[A-Z]+)?-[0-9]{3,}$", "example": "REQ-STD-001"},
        "finding":               {"pattern": "^F-[0-9]{3,}$", "example": "F-001"},
        "change_request":        {"pattern": "^SCR-[0-9]{3,}$", "example": "SCR-001"},
        "architecture_decision": {"pattern": "^(AD|ADR)-[0-9]{3,}$", "example": "ADR-001", "note": "Zentrales DECISIONS_REGISTER nutzt AD-NNN (bestehende Nummern unveraendert)"},
        "security_advisory":     {"pattern": "^ATC-SA-[0-9]{3,}$", "example": "ATC-SA-001"},
        "test_case":             {"pattern": "^TC-[0-9]{3,}$", "example": "TC-001"},
        "test_suite":            {"pattern": "^TS-[0-9]{3,}$", "example": "TS-001"},
        "validation_gate":       {"pattern": "^GATE-[0-9]{3,}$", "example": "GATE-001"},
        "schema":                {"pattern": "^ATC-SCHEMA-[0-9]{3,}$", "example": "ATC-SCHEMA-001"},
        "protocol":              {"pattern": "^ATC-PROTO-[0-9]{3,}$", "example": "ATC-PROTO-001"},
        "specification":         {"pattern": "^ATC-SPEC-[0-9]{3,}$", "example": "ATC-SPEC-001"},
        "release":               {"pattern": "^ATC-REL-[0-9]+[.][0-9]+[.][0-9]+$", "example": "ATC-REL-1.0.0"},
        "document":              {"pattern": "^ATC-DOC-[0-9]{3,}$", "example": "ATC-DOC-001"}
      }
    },
    "repositories": {
      "type": "object",
      "properties": {
        "new_repo_pattern": {"pattern": "^atc-[a-z0-9]+(-[a-z0-9]+)*$", "example": "atc-standards-validator"},
        "grandfathered": {
          "type": "array",
          "description": "Bestehende Brand-Repos behalten ihre Namen (Immutabilitaet, AD-014/016-Struktur)",
          "items": {"enum": ["atclang", "a-townchain", "globus-os", "aurora-ai", "genesis-engine", "genesis-chronicles", "a-townchain-os", "a-townchain-os-docs"]}
        }
      }
    },
    "files": {
      "type": "object",
      "properties": {
        "standard_doc": {"pattern": "^ATC-STD-[0-9]{3,}[.]md$", "example": "ATC-STD-000.md"},
        "schema_doc":   {"pattern": "^[a-z0-9-]+[.]schema[.](json|yaml)$", "example": "naming-conventions.schema.json"},
        "integrity":    {"pattern": "^ATC-STD-[0-9]{3,}[.]integrity[.]yaml$"},
        "review":       {"pattern": "^ATC-STD-[0-9]{3,}[.]review[.]yaml$"},
        "compliance":   {"pattern": "^ATC-STD-[0-9]{3,}[.]compliance[.]yaml$"}
      }
    },
    "immutability": {
      "type": "object",
      "required": ["rule"],
      "properties": {
        "rule": {"const": "IDs werden nie umbenannt, wiederverwendet oder neu vergeben; nur Version/Status/Titel/Kategorie aendern sich."},
        "version_pinning": {"const": "ATC-STD-042@1.0.0 bleibt exakt diese Fassung (s29)"}
      }
    }
  }
}
