{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://a-townchain-okosystems/standards/schemas/evidence/record.schema.json",
  "title":"ATC-STD-644 Evidence Record",
  "type":"object",
  "required":["id","type","version"],
  "properties":{
    "id":{"type":"string","pattern":"^ATC-(REQ|SPEC|COMP|FUNC|IMPL|CHANGE|DOC|TEST|CI|E2E|AUDIT|REL)-[A-Z0-9][A-Z0-9-]*$"},
    "type":{"enum":["REQUIREMENT","SPECIFICATION","COMPONENT","FUNCTION","IMPLEMENTATION","CHANGE","DOCUMENTATION","TEST","CI","E2E","AUDIT","RELEASE"]},
    "version":{"type":"string","minLength":1},
    "status":{"enum":["PRESENT","SPECIFIED","DOCUMENTED","IMPLEMENTED","TESTED","CI-VERIFIED","E2E-VERIFIED","AUDITED","RELEASE-READY","NOT_PROVEN","NOT_READY","PASS","FAIL","SKIPPED","INCOMPLETE","BROKEN"]},
    "references":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^ATC-(REQ|SPEC|COMP|FUNC|IMPL|CHANGE|DOC|TEST|CI|E2E|AUDIT|REL)-[A-Z0-9][A-Z0-9-]*$"}},
    "repository":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},
    "module":{"type":"string","minLength":1},"symbol":{"type":"string","minLength":1},
    "commit_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "base_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "head_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "classification":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["ADD","MODIFY","REMOVE","REFACTOR","SECURITY","BUGFIX","API_CHANGE","ABI_CHANGE","DEPENDENCY_CHANGE","CONFIG_CHANGE","DOCUMENTATION_ONLY","TEST_ONLY"]}},
    "run_id":{"type":"string","minLength":1},"job_id":{"type":"string","minLength":1},
    "step_name":{"type":"string","minLength":1},"step_number":{"type":"integer","minimum":1},
    "result":{"enum":["PASS","FAIL","SKIPPED"]},
    "test_kind":{"enum":["positive","negative","boundary","regression"]}
  },
  "allOf":[
    {"if":{"properties":{"type":{"const":"IMPLEMENTATION"}},"required":["type"]},"then":{"required":["repository","path","module","symbol","commit_sha"]}},
    {"if":{"properties":{"type":{"const":"CHANGE"}},"required":["type"]},"then":{"required":["base_sha","head_sha","classification"]}},
    {"if":{"properties":{"type":{"const":"CI"}},"required":["type"]},"then":{"required":["commit_sha","run_id","job_id","step_name","step_number","result"]}},
    {"if":{"properties":{"type":{"const":"TEST"}},"required":["type"]},"then":{"required":["test_kind"]}}
  ],
  "additionalProperties":false
}