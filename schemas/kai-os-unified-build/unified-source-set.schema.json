{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atc:kai-os:scr-0145:unified-source-set:0.1.0",
  "title": "KAI-OS Unified Source Set",
  "description": "DRAFT schema; pins every repository source used by one unified KAI-OS release. Non-normative pending SCR-0145 approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "product_version",
    "source_set_id",
    "captured_at_utc",
    "repositories",
    "source_set_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "product": {
      "const": "KAI-OS"
    },
    "product_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "source_set_id": {
      "type": "string",
      "minLength": 1
    },
    "captured_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository_full_name",
          "commit_sha",
          "components"
        ],
        "properties": {
          "repository_full_name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "repository_id": {
            "type": [
              "string",
              "integer"
            ]
          },
          "default_branch": {
            "type": "string",
            "minLength": 1
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40,64}$"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "submodules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "repository_url",
                "commit_sha"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "repository_url": {
                  "type": "string",
                  "format": "uri"
                },
                "commit_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40,64}$"
                }
              }
            }
          },
          "dependency_locks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "source_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
