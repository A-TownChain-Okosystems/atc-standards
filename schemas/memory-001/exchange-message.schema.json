{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://atc.ecosystem/schemas/memory-001/exchange-message.schema.json",
  "title":"MEMORY-001 Federation Exchange Message",
  "type":"object","additionalProperties":false,
  "required":["protocol","version","message_type","message_id","sender","receiver","nonce","record","record_hash","signature"],
  "properties":{
    "protocol":{"const":"MEMORY-001"},
    "version":{"const":"1.0.0"},
    "message_type":{"enum":["RECORD_PUT","RECORD_GET","RECORD_RESPONSE","RECORD_DELETE","REJECT"]},
    "message_id":{"type":"string","pattern":"^msg_[a-z0-9][a-z0-9_-]{15,127}$"},
    "sender":{"type":"string","pattern":"^node_[a-z0-9][a-z0-9_-]{15,127}$"},
    "receiver":{"type":"string","pattern":"^node_[a-z0-9][a-z0-9_-]{15,127}$"},
    "nonce":{"type":"string","pattern":"^[A-Za-z0-9_-]{16,128}$"},
    "record":{"type":["object","null"]},
    "record_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "signature":{"type":"string","pattern":"^ed25519:[A-Za-z0-9_-]{20,}$"},
    "error":{"type":["object","null"],"additionalProperties":false,"properties":{
      "error_code":{"type":"string","enum":["MEMORY-AUTH-001","MEMORY-AUTHZ-001","MEMORY-CANON-001","MEMORY-CONFLICT-001","MEMORY-NOTFOUND-001","MEMORY-NONCE-001","MEMORY-SCHEMA-001","MEMORY-VERSION-001"]},
      "retryable":{"type":"boolean"},
      "message":{"type":"string","maxLength":512}
    }}
  }
}