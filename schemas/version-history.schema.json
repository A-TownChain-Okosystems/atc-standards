{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/A-TownChain-Okosystems/atc-standards/blob/main/schemas/version-history.schema.json",
  "title": "ATC Machine-Readable Version History",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "standard_id",
    "canonical_source",
    "history"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "standard_id": {
      "type": "string",
      "pattern": "^ATC-[A-Z0-9-]+$"
    },
    "canonical_source": {
      "type": "string",
      "minLength": 1
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "date",
          "normative_status",
          "publication_status",
          "change_type",
          "summary",
          "changes",
          "compatibility",
          "source",
          "evidence"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "normative_status": {
            "enum": [
              "draft",
              "candidate",
              "approved",
              "deprecated",
              "withdrawn",
              "unknown"
            ]
          },
          "publication_status": {
            "enum": [
              "published",
              "proposed_in_open_pr",
              "superseded",
              "unknown"
            ]
          },
          "change_type": {
            "enum": [
              "initial",
              "patch",
              "minor",
              "major",
              "approval",
              "metadata",
              "security",
              "crypto",
              "other"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "compatibility": {
            "enum": [
              "backward_compatible",
              "breaking",
              "editorial",
              "not_applicable",
              "unknown"
            ]
          },
          "change_request_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri-reference"
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "commit_sha",
              "pull_request"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "commit_sha": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pull_request": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "verified",
                  "not_verified",
                  "residual",
                  "unknown"
                ]
              },
              "verified_commit_sha": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^([0-9a-f]{40})?$"
              },
              "workflow_run_url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "notes": {
                "type": "string"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "verified"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "verified_commit_sha",
                    "workflow_run_url"
                  ],
                  "properties": {
                    "verified_commit_sha": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    "workflow_run_url": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
